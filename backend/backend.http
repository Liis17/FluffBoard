@backend_HostAddress = http://localhost:5279

GET {{backend_HostAddress}}/api/hello
Accept: application/json

###

# Log in first and let your HTTP client retain the session cookie.
POST {{backend_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "replace-with-a-long-password"
}

###

GET {{backend_HostAddress}}/api/board/issues
Accept: application/json

###

# Board columns: the three built-in statuses plus any custom status:* label.
GET {{backend_HostAddress}}/api/board/statuses
Accept: application/json

###

# Status, priority and platforms are separate fields; the backend turns them into status:*,
# priority:* and platform:* labels. Send only regular labels here, omit "priority" for no
# priority, and note that a task may target several platforms at once.
POST {{backend_HostAddress}}/api/board/issues
Content-Type: application/json

{
  "title": "A task created from FluffBoard",
  "body": "This issue is synchronized with GitHub.",
  "labels": ["Баг"],
  "assignees": ["octocat"],
  "status": "todo",
  "priority": "high",
  "platforms": ["backend", "windows"]
}

###

# Moving a task to "done" closes the issue; moving it back reopens it. PUT replaces the issue
# as a whole, so every field has to be present — an omitted "platforms" clears them.
PUT {{backend_HostAddress}}/api/board/issues/1
Content-Type: application/json

{
  "title": "A task created from FluffBoard",
  "body": "This issue is synchronized with GitHub.",
  "labels": ["Баг"],
  "assignees": ["octocat"],
  "status": "done",
  "priority": "high",
  "platforms": ["backend", "windows"]
}

###
