# Скопировать в .env рядом с docker-compose.yml и заполнить. Файл не коммитится.

# Порт на 127.0.0.1 сервера, с которого доску забирает nginx; должен совпадать с upstream
# в docker/nginx/fluffboard.conf. Внутри контейнера всегда 8080.
FLUFFBOARD_PORT=8080

# Сервисный GitHub-аккаунт: fine-grained token с правом Issues: Read and write на нужную репозиторию.
GitHub__Token=github_pat_replace_me

# Единственная репозитория, которую показывает эта установка доски.
Board__Repository__Owner=octocat
Board__Repository__Name=Hello-World

# Пользователи доски. Пароль хранится только PBKDF2-хешем, но в этом файле он открытый.
# Пользователей может быть несколько: Board__Users__1__*, Board__Users__2__* и так далее.
# Удалённый отсюда пользователь удаляется из базы при следующем запуске.
Board__Users__0__Username=admin
Board__Users__0__Password=replace-with-a-long-password
Board__Users__0__GitHubLogin=octocat
Board__Users__0__TelegramId=123456789
